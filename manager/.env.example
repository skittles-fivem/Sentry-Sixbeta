# Copy to .env and edit. Every setting is optional unless marked.

# Time zone, used for day boundaries of files that have no Tesla timestamp.
TZ=America/Chicago

# ---- SMB share with your TeslaCam footage (the container mounts it itself)
# //server/share or //server/share/sub/folder. Prefer the NAS IP address.
SMB_SHARE=//192.168.1.50/TeslaCam
SMB_USERNAME=tesla
SMB_PASSWORD=change-me
# SMB_DOMAIN=WORKGROUP
# 3.0 by default; try 3.1.1, 2.1 or 2.0 if the mount fails with error 112/95.
# SMB_VERSION=3.0
# Extra mount.cifs options, comma separated (e.g. seal for encryption).
# SMB_OPTIONS=
# Owner of files the manager writes on the share.
# PUID=1000
# PGID=1000

# ---- Encoding
# Re-encode footage automatically to save space.
AUTO_ENCODE=true
# h264 keeps clips playable in Sentry Studio (with telemetry).
# hevc is ~30-50% smaller again, but Sentry Studio cannot open HEVC clips.
ENCODE_CODEC=h264
# auto picks the first working one of nvenc, qsv, vaapi, software.
ENCODER=auto
# ENCODER_DEVICE=/dev/dri/renderD128
# Lower = better quality, bigger files. Default 26 (h264) / 28 (hevc).
# ENCODE_QUALITY=26
# CPU encoder speed preset (ultrafast ... veryslow).
# ENCODE_PRESET=faster
# Keep Tesla's per-frame telemetry (speed, GPS, Autopilot). Encoders that would
# drop it are not used while this is true.
PRESERVE_TELEMETRY=true
# Only touch clips this old, so files still being copied are left alone.
ENCODE_MIN_AGE_MINUTES=30
# Keep the original if the new file is not at least this much smaller.
# ENCODE_MIN_SAVINGS_PERCENT=10
# Which folders to encode: RecentClips,SentryClips,SavedClips,Other
# ENCODE_TYPES=RecentClips,SentryClips,SavedClips,Other
# ENCODE_CONCURRENCY=1

# ---- Web UI
# Set a password to require a login (user name defaults to admin).
# UI_PASSWORD=
# UI_USERNAME=admin
# SCAN_INTERVAL_MINUTES=15

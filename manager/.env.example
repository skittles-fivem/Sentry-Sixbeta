# Copy to .env to change defaults. Everything is optional: vehicles, shares
# and the account are all managed in the web UI.

# Time zone of the server (policy run times, logs).
TZ=America/Chicago

# Create the account on first start instead of with the setup code from
# the log (docker logs sentry-six-manager).
# UI_USERNAME=admin
# UI_PASSWORD=change-me

# HTTPS: the names / IP addresses you use to reach the server, so the
# certificate covers them (more can be added in Settings > Security).
# TLS_HOSTNAMES=192.168.1.20,nas.local
# Your own certificate instead of the built-in local CA:
# TLS_CERT_FILE=/data/my-cert/fullchain.pem
# TLS_KEY_FILE=/data/my-cert/privkey.pem
# Plain HTTP, only behind a reverse proxy that does HTTPS:
# TLS_MODE=off
# TRUST_PROXY=true
# Refuse requests for any other host name (DNS rebinding protection):
# TRUSTED_HOSTS=192.168.1.20,nas.local

# Create a first vehicle on first start (more can be added in Settings).
# VEHICLE_NAME=Daily Driver
# SMB_SHARE=//192.168.1.50/TeslaCam
# SMB_USERNAME=tesla
# SMB_PASSWORD=change-me
# SMB version: 3.1.1, 3.02, 3.0 or 3 (= 3.0 or newer); SMB 1/2 are not allowed.
# SMB_VERSION=3.1.1
# Encryption; false = signed only (others on the network could watch).
# SMB_ENCRYPT=true

# The unprivileged user the web app runs as; it owns /data and the files on
# the shares. Must not be 0.
# PUID=1000
# PGID=1000

# Which image to follow: latest, or a branch's own image (its name).
# SENTRY_TAG=latest

# Settings > Updates asks the registry twice a day whether a newer image is
# out (it never installs anything; you run docker compose pull). Turn it off:
# UPDATE_CHECK=off

# Extra folders (inside the container) the converter may write to, ':'-separated.
# EXTRA_ROOTS=/converted

# Re-scan every vehicle this often (minutes).
# SCAN_INTERVAL_MINUTES=15

# Folder vehicles must be inside /footage (mount them there); more roots:
# FOLDER_ROOTS=/media/footage

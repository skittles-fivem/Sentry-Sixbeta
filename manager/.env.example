# Copy to .env to change defaults. Everything is optional: vehicles, shares,
# the account and update settings are all managed in the web UI.

# Time zone of the server (policy run times, logs).
TZ=America/Chicago

# Create the account on first start instead of on the sign-in page.
# UI_USERNAME=admin
# UI_PASSWORD=change-me

# Create a first vehicle on first start (more can be added in Settings).
# VEHICLE_NAME=Daily Driver
# SMB_SHARE=//192.168.1.50/TeslaCam
# SMB_USERNAME=tesla
# SMB_PASSWORD=change-me
# SMB_VERSION=3.0

# Owner of files written on the shares (uid/gid mount options).
# PUID=1000
# PGID=1000

# Updates from GitHub (also editable in Settings).
# UPDATE_REPO=skittles-fivem/Sentry-Sixbeta
# UPDATE_BRANCH=claude/sentry-manager-docker-ui-q31i6f

# Extra folders (inside the container) the converter may write to, ':'-separated.
# EXTRA_ROOTS=/converted

# Re-scan every vehicle this often (minutes).
# SCAN_INTERVAL_MINUTES=15

# Send cookies only over HTTPS (when behind a TLS reverse proxy).
# SECURE_COOKIES=true
